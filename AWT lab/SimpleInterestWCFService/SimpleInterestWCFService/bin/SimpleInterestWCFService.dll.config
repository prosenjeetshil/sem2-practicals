<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
	</system.web>

	<system.serviceModel>
		<services>
			<service name="SimpleInterestWCFService.Service1">
				<endpoint address=""
						  binding="basicHttpBinding"
						  contract="SimpleInterestWCFService.IService1" />
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8000/Service1" />
					</baseAddresses>
				</host>
			</service>
		</services>
		<behaviors>
			<serviceBehaviors>
				<behavior>
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
	</system.serviceModel>

	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true" />
		<handlers>
			<!-- REMOVE duplicate handler if it already exists globally -->
			<clear/>
			<add name="svc-Integrated" path="*.svc"
				 verb="*" type="System.ServiceModel.Activation.ServiceHttpHandlerFactory"
				 resourceType="Unspecified"
				 preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
	</system.webServer>
</configuration>
